# Salin file ini menjadi .env lalu isi dengan kredensial project Supabase kamu:
#   cp .env.example .env
# Ambil dari Supabase Dashboard > Settings > API:
#   Project URL  -> EXPO_PUBLIC_SUPABASE_URL
#   anon public  -> EXPO_PUBLIC_SUPABASE_ANON_KEY
# PENTING: pakai ANON key, BUKAN service_role key (service_role jangan
# pernah dimasukkan ke aplikasi mobile / di-push ke GitHub).
# File .env SUDAH diabaikan .gitignore dan tidak ikut di-push.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
